# Copia este archivo a .env y rellena valores locales.
# Nunca commitees .env ni passwords reales al repositorio.

# PostgreSQL (docker compose + SQLAlchemy)
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_password_local
POSTGRES_DB=pronosticos_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:cambia_esta_password_local@localhost:5432/pronosticos_ai

# Auth JWT — obligatorio; genera uno largo y aleatorio
SECRET_KEY=genera_un_secreto_largo_y_aleatorio

# Front (Vite). Lista separada por comas; no uses *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# APIs externas (opcionales según feature)
# FOOTBALL_DATA_TOKEN=
# ODDS_API_KEY=
# DEEPSEEK_API_KEY=
